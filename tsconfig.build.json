{
  "compilerOptions": {
    "module": "preserve",
    "target": "es2020",
    "lib": ["es2020", "dom"],
    "rootDir": "./src",
    "outDir": "./dist",
    "moduleResolution": "bundler",
    "sourceRoot": "./src",
    "types": ["node"],
    "sourceMap": true,
    "strict": true,
    "declaration": true,
    "removeComments": false,
    "inlineSources": true,
    "inlineSourceMap": false,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noImplicitAny": true,
    "importHelpers": true,
    "strictNullChecks": true,
    "noUnusedLocals": true
  },
  "typedocOptions": {
    "entryPoints": ["src/index.ts"],
    "out": "docs"
  },
  "include": ["src"],
  "exclude": ["node_modules", "test"]
}
